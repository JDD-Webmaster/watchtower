APP_NAME=WatchTower
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# The frontend's own URL — used for CORS (only this origin can make
# credentialed requests) and for building real links inside reminder
# SMS/emails (App\Services\ReminderDispatchService).
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker Compose sets DB_HOST=mysql automatically — these are for running
# the API outside Docker (e.g. local development against a MySQL you run
# yourself).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=watchtower
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Feature flag ──────────────────────────────────────────────────────────
# WatchTower only has one job — this is on by default, but gives you a
# hard kill switch for the whole reminder engine without touching code.
REMINDERS_ENABLED=true

# ─── SMS ──────────────────────────────────────────────────────────────────
# Kudi for Nigerian recipients, Termii for everywhere else — see
# App\Services\Sms\SmsRouter. Leave blank and reminders just log a
# skipped-SMS warning; email still goes out on its own.
KUDI_SMS_API_KEY=
KUDI_SMS_SENDER_ID=WatchTower
KUDI_SMS_ENDPOINT=https://my.kudisms.net/api/corporate
KUDI_SMS_GATEWAY=2

TERMII_API_KEY=
TERMII_SENDER_ID=WatchTower
TERMII_BASE_URL=https://api.ng.termii.com/api
TERMII_CHANNEL=generic
